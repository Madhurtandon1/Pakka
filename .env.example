SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
PAKKA_DB=pakka.db
# Optional: LLM intent labels for merchant replies. Unset = offline keywords.
#   anthropic: pip install anthropic     (PAKKA_LLM_MODEL defaults to claude-haiku-5-5)
#   gemini:    pip install google-genai  (PAKKA_LLM_MODEL is required, e.g. your Gemini model name)
#   sarvam:    pip install sarvamai      (uses SARVAM_API_KEY above; PAKKA_LLM_MODEL defaults to sarvam-105b)
PAKKA_LLM_PROVIDER=
PAKKA_LLM_API_KEY=
PAKKA_LLM_MODEL=
# Seconds between calls in eval/intent_holdout.py (default 4.5 for gemini's free tier, 0 for anthropic)
PAKKA_LLM_PAUSE=
