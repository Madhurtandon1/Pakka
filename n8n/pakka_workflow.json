          {
            "node": "Respond 200",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Respond 200": {
      "main": [
        [
          {
            "node": "Switch on action",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Switch on action": {
      "main": [
        [
          {
            "node": "SMS / WhatsApp (disabled)",
            "type": "main",
            "index": 0
          },
          {
            "node": "Log (simulated send)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait until scheduled_for",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Add to RM queue (HTTP back to Pakka)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log (other action)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait until scheduled_for": {
      "main": [
        [
          {
            "node": "Log (reminder due)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
